// Zellij configuration
// https://zellij.dev/documentation/

// Hide pane frames for a cleaner look (toggle with Ctrl+p f)
pane_frames false

// Copy to system clipboard on select
copy_on_select true

// Mouse support
mouse_mode true

// Disable startup tips
show_startup_tips false

// Use Nushell for new panes, regardless of the parent terminal's shell
default_shell "nu"

// Keep host keybindings active: Mac Alt keys control the outer session,
// while unhandled Ctrl keys reach the Linux session over SSH.
nested_session_handling "never"

// Enable session serialization/resurrection
session_serialization true
pane_viewport_serialization true
scrollback_lines_to_serialize 10000
serialization_interval 5

themes {
    nord {
        ribbon_unselected {
