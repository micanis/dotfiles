# ~/.profile — managed by chezmoi
# Read by login shells (bash, dash, sh) on most distributions

# Source .bashrc if running bash interactively
[ -n "$BASH_VERSION" ] && [ -f "$HOME/.bashrc" ] && . "$HOME/.bashrc"

# Local binaries (chezmoi-managed tools: zellij, nu, hx, starship, devbox, etc.)
[ -d "$HOME/.local/bin" ] && PATH="$HOME/.local/bin:$PATH"
export PATH

# True color (24-bit) — Linux 環境で Helix 等のテーマカラーが 256 色に丸められないように明示
export COLORTERM="truecolor"
