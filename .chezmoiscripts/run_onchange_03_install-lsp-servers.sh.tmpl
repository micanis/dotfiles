#!/usr/bin/env bash
# Install LSP servers for Helix.
# Reruns when this file changes (server versions / additions).
#
# OS-specific binary LSPs (marksman, taplo, clangd, jdtls on macOS) are
# installed by run_onchange_01_install.sh.tmpl. This script handles language-
# manager-installed LSPs and the Linux-side jdtls download.

set -euo pipefail

export PATH="$HOME/.cargo/bin:$HOME/.local/bin:$HOME/go/bin:/usr/local/go/bin:$HOME/.bun/bin:$PATH"

# ── Python: basedpyright + ruff (via uv) ──────────────────────────────────────
if command -v uv >/dev/null 2>&1; then
    uv tool install basedpyright --upgrade 2>/dev/null || uv tool install basedpyright
    uv tool install ruff          --upgrade 2>/dev/null || uv tool install ruff
else
    echo "WARN: uv not found, skipping basedpyright and ruff" >&2
fi

# ── JS/TS / YAML / Bash / Dockerfile: bun-installed servers ───────────────────
if command -v bun >/dev/null 2>&1; then
    bun add -g typescript typescript-language-server
    bun add -g @biomejs/biome
    bun add -g yaml-language-server
    bun add -g bash-language-server
    bun add -g dockerfile-language-server-nodejs
else
    echo "WARN: bun not found, skipping JS/YAML/Bash/Dockerfile LSPs" >&2
fi

# ── Go: gopls ────────────────────────────────────────────────────────────────
if command -v go >/dev/null 2>&1; then
    go install golang.org/x/tools/gopls@latest
else
    echo "WARN: go not found, skipping gopls" >&2
fi

# ── Rust: rust-analyzer (via rustup component) ────────────────────────────────
if command -v rustup >/dev/null 2>&1; then
    rustup component add rust-analyzer
else
    echo "WARN: rustup not found, skipping rust-analyzer" >&2
fi

# ── Java: jdtls (Linux only — macOS uses `brew install jdtls`) ───────────────
{{ if eq .chezmoi.os "linux" -}}
# Eclipse JDT-LS ships as a milestone tarball with a stable "latest" symlink.
# We extract under ~/.local/share/jdtls and write a wrapper to ~/.local/bin/jdtls
# so Helix's `jdtls` command works without further config.
JDTLS_DIR="$HOME/.local/share/jdtls"
JDTLS_BIN="$HOME/.local/bin/jdtls"

if [ ! -x "$JDTLS_BIN" ] || [ ! -d "$JDTLS_DIR/plugins" ]; then
    mkdir -p "$JDTLS_DIR"
    JDTLS_URL="https://download.eclipse.org/jdtls/snapshots/jdt-language-server-latest.tar.gz"
    TMP=$(mktemp /tmp/jdtls.XXXXXX.tar.gz)
    if curl -fsSL --retry 3 -o "$TMP" "$JDTLS_URL"; then
        tar xz -C "$JDTLS_DIR" -f "$TMP"
        rm -f "$TMP"

        # Resolve Java: prefer SDKMAN's current java, fall back to PATH.
        JAVA_CMD="java"
        if [ -s "$HOME/.sdkman/bin/sdkman-init.sh" ]; then
            JAVA_CMD="$HOME/.sdkman/candidates/java/current/bin/java"
        fi

        cat > "$JDTLS_BIN" <<EOF
#!/usr/bin/env bash
# Wrapper for Eclipse JDT-LS — generated by chezmoi
JDTLS_DIR="$JDTLS_DIR"
LAUNCHER=\$(ls "\$JDTLS_DIR"/plugins/org.eclipse.equinox.launcher_*.jar 2>/dev/null | head -1)
CONFIG_DIR="\$JDTLS_DIR/config_linux"
WORKSPACE="\$HOME/.cache/jdtls/workspace-\$(echo "\$PWD" | sha1sum | cut -c1-8)"
mkdir -p "\$WORKSPACE"
exec "$JAVA_CMD" \\
    -Declipse.application=org.eclipse.jdt.ls.core.id1 \\
    -Dosgi.bundles.defaultStartLevel=4 \\
    -Declipse.product=org.eclipse.jdt.ls.core.product \\
    -Dlog.level=ALL \\
    -Xmx1G \\
    --add-modules=ALL-SYSTEM \\
    --add-opens java.base/java.util=ALL-UNNAMED \\
    --add-opens java.base/java.lang=ALL-UNNAMED \\
    -jar "\$LAUNCHER" \\
    -configuration "\$CONFIG_DIR" \\
    -data "\$WORKSPACE" \\
    "\$@"
EOF
        chmod +x "$JDTLS_BIN"
        echo "✓ jdtls installed to $JDTLS_DIR"
    else
        rm -f "$TMP"
        echo "WARN: jdtls download failed, skipping" >&2
    fi
fi
{{- end }}

echo "✓ LSP servers installed"
